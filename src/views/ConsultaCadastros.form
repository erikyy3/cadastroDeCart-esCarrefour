          </Properties>
          <AuxValues>
            <AuxValue name="JavaCodeGenerator_InitCodePre" type="java.lang.String" value="String[] colunas = {&quot;CPF&quot;, &quot;Telefone&quot;, &quot;Email&quot;};&#xa;DefaultTableModel tabelaModelo = new DefaultTableModel(colunas, 0);&#xa;&#xa;ListaUsuarios listagem = new ListaUsuarios();&#xa;&#xa;List&lt;Usuario&gt; listaCompleta = listagem.listar();&#xa;&#xa;for(int i = 0; i &lt; listaCompleta.size(); i++){&#xa;Usuario usuarioAtual = listaCompleta.get(i);&#xa;&#xa;String[] linha = {&#xa;usuarioAtual.getCPF(),&#xa;usuarioAtual.getTelefone(),&#xa;usuarioAtual.getEmail()&#xa;};&#xa;&#xa;tabelaModelo.addRow(linha);&#xa;};"/>
          </AuxValues>
        </Component>
      </SubComponents>
    </Container>
